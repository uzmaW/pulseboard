# PulseBoard Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=ecto://pulseboard:pulseboard_dev@localhost/pulseboard_dev

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=pulseboard-dev-token

# LiveKit
LIVEKIT_API_KEY=dev-api-key
LIVEKIT_API_SECRET=dev-api-secret
LIVEKIT_URL=ws://localhost:7880

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123

# Guardian (Auth)
GUARDIAN_SECRET_KEY=your-secret-key-here

# Phoenix
PHX_HOST=localhost
PHX_PORT=4000
SECRET_KEY_BASE=your-secret-key-base-here
